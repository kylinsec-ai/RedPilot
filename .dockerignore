# ══════════════════════════════════════════════════════════════
# 构建上下文裁剪
# ⚠️ Dockerfile 真正需要的只有 5 项：requirements.txt / adapter/ /
#    drivers/ / skills/ / entrypoint.sh —— 下面任何一条都不要去排除它们。
# ══════════════════════════════════════════════════════════════

# 运行期产物：含各题 FLAG / MEMORY / SOURCE / _events.jsonl / _transcripts，
# 既非构建输入，也不该随上下文上传（题号与靶标情报不进产物的口径）
work/
_transcripts/

# root 属主的运行数据：普通用户读不了，会让构建在"检查上下文"阶段直接失败
# （error checking context: no permission to read from .../data/vpn/openvpn.log）
data/
vpn/

# 非构建输入的大目录（.git/.venv/前端 合计 50M+），纯拖慢构建
.git/
.venv/
fastapi-console/
tsecbench-frontend/
tsecbench/
tests/
tools/

# 凭据与环境文件：绝不进构建上下文
.agent.env
.agent.env.*
.env
.env.*

# 杂项
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
*.log
*.tmp
