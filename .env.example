# ══════════════════════════════════════════════════════════════
# .env 模板（单 .env 喂所有 compose 服务）
# 复制为 .env 并填入实际值。上半是 worker/舰队段，下半是 server(控制面+观测)段。
# ══════════════════════════════════════════════════════════════

# ── 平台地址与凭据（必填；托管模式由平台注入）──
BENCHMARK_TOKEN=replace-with-your-platform-token
BENCHMARK_BASE_URL=http://127.0.0.1:8000

# ── 本地 control assignment 模式（可选；与题目 token 分离）──
# WORKER_MODE=assignment
# PLATFORM_URL=http://server:8000
# PLATFORM_WORKER_TOKEN=replace-with-worker-service-token

# ── control 服务 ──
# GHOST_ADMIN_TOKEN=replace-with-admin-token
# GHOST_WORKER_TOKEN=replace-with-worker-service-token（与 PLATFORM_WORKER_TOKEN 同值；宿主裸跑用此名）
# GHOST_TASKS_JSON={"tasks":[{"token":"task-token","challenges":[]}]}
# GHOST_PUBLIC_BASE_URL=http://server:8000（assignment 下发给 worker 的 benchmark 地址；为空回落 PLATFORM_URL）
# ASSIGNMENT_LEASE_SECONDS=300

# ── LLM 凭据 —— pi 官方 provider env 名，直通容器（仓库代码不读不改）──
# 默认 provider 为 deepseek，官方 env 名 = DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 换 provider: 在 docker-compose.yaml 加一行同名转发，并在此用其官方 env 名
# (provider→env 对照表见 README，或 https://pi.dev/docs/latest/providers)

# ── 模型（可选；完整 [provider/]model 逐字透传，缺省 deepseek/deepseek-v4-flash）──
# SOLVER_MODEL=deepseek/deepseek-v4-flash
# 也可按 preset 名选择（deepseek / deepseek-1m / glm / glm-1m），与 SOLVER_MODEL 二选一
# ADAPTER_PROVIDER=deepseek
# verifier / heimdall 侧独立模型（可选；缺省与 solver 同）
# VERIFIER_MODEL=
# SOLVER_GATEWAY=0（1 = 把 API 域名转为 http://<host>.tsecbench.gw 的托管网关模式）

# ── 可选: 单会话时长 / VPN 配置 / flag 格式 / 心跳容忍 ──
# SOLVER_SESSION_SECONDS=1500
# ADAPTER_VPN_CONFIG=/vpn/client.ovpn
# ADAPTER_FLAG_FORMAT=flag{...}
# PI_STALL_TIMEOUT=480
# WATCHDOG_MAX_IDLE_SECONDS=300

# ── 可选: 实时监视页/SSE 端口（0=禁用，求解不受影响）与 worker 名 ──
# 注意: 设为 0 时须同步注释掉 docker-compose.yaml 的 ports 段，
# 否则端口映射通不过 compose 校验，容器无法启动。
# STATUS_PORT=8080
# 宿主侧发布绑定: 默认仅回环（态势台数据无鉴权: 实时 FLAG/完整实录）；
# 确需 LAN/远程查看才显式放行 STATUS_HOST_IP=0.0.0.0（答案泄露风险自担）
# STATUS_HOST_IP=127.0.0.1
# 容器内监听地址: compose 默认 0.0.0.0（docker-proxy 转发需要全网卡监听，
# 暴露面由上方 STATUS_HOST_IP 收口）；宿主直跑 driver 默认 127.0.0.1
# STATUS_BIND=0.0.0.0
# WORKER_ID=worker-1

# ══════════════════════════════════════════════════════════════
# 求解策略段（朋友线移植；未设置即用代码内默认值）
# ══════════════════════════════════════════════════════════════

# ── 调度参数 ──
# 并行挑战数（对齐平台活跃实例上限）
# ADAPTER_MAX_CONCURRENCY=3
# 整体运行挂钟上限（秒）
# ADAPTER_TOTAL_SECONDS=21300
# 各轮单题访问时长（秒，递增；轮数 = 元素个数）
# ADAPTER_ROUND_TIMEBOXES=480,820,1500,2000
# 是否使用平台提示（非简单题、仅卡住时）
# ADAPTER_USE_HINTS=0
# 实例保活配额
# ADAPTER_KEEPALIVE_MAX=2
# 工作目录根
# ADAPTER_WORKDIR=/work

# ── 止损参数 ──
# 单题最大总时间（秒，与困难题 90 分钟时间盒对齐）
# ADAPTER_PER_CHALLENGE_SECONDS=5400
# 单题最大会话数
# ADAPTER_MAX_SESSIONS=8
# 连续无新事实允许的会话数
# ADAPTER_DRY_FACTS_CUTOFF=3
# 单 flag 题连续 3 场未拿到平台确认 flag 即切换题目
# ADAPTER_ZERO_FLAG_CUTOFF=4
# 终身会话硬顶（0 = 用本轮计数；>0 = 用终身计数，revive 不重置）
# ADAPTER_LIFETIME_SESSIONS_CAP=0
# 复活冷却（秒）
# ADAPTER_REVIVE_COOLDOWN=900

# ── 舰队参数（docker-compose.fleet.yaml 用）──
# worker 能力标签（解题目 worker 同质，不按角色分工）
# ADAPTER_CAPABILITIES=web,cloud,pwn,reverse,forensics,crypto,pentest,evasion,misc
# 自动派发循环: 轮询间隔 / 挂掉题重试冷却 / 每题最大自动重试次数 / API 退避
# ADAPTER_AUTO_POLL=60
# ADAPTER_DROP_RETRY=600
# ADAPTER_AUTO_MAX_RETRY=3
# ADAPTER_API_BACKOFF=600

# ── pi 扩展与子代理 ──
# bash-guard 扩展: pi bash 工具强制 timeout/ulimit + 自引用写拦截（P0 防盘爆）
# PI_BASH_TIMEOUT_SECONDS=600
# PI_BASH_MAX_FILE_MB=4096
# ADAPTER_PI_EXTENSIONS=/app/packages/worker/ghost_worker/pi_ext/bash_guard.js
# 观察者 Agent（Heimdall）: 只读复盘，额外占一次 LLM 调用与最长 45 秒。默认关闭。
# ADAPTER_HEIMDALL=0

# ── 观测平台（已并入服务端，同一 :8000 端口）──
# 摄取鉴权 token: 服务端常量时间校验，worker 中继同值发送；
# 未配: ingest 响亮 503（防静默空转），relay 照发并记 warn —— 只配 URL 忘配
# token 会看到平台全灰而非日志静默丢失（两者语义不同，README 有述）。
# OBSERVABILITY_TOKEN=
# 观测读端凭据（态势台、runs 历史、transcript）。读端返回**明文 flag 与完整 agent
# 实录**，故不再匿名开放；worker 容器持 ingest token 且与平台同网，靠网络位置兜底
# 已被证明不够 —— 用独立读凭据可让"能写遥测"不等于"能读答案"。
# 未设置时回落到 OBSERVABILITY_TOKEN（默认部署即有凭据）；两者皆无则读端 503。
# OBSERVABILITY_READ_TOKEN=
# compose 网络内 worker 自动指向 http://server:8000（service DNS）；
# 宿主直跑 driver 时需显式设 OBSERVABILITY_URL=http://127.0.0.1:8000

# ── 服务端监听 ──
# 宿主侧发布绑定: 默认仅回环。态势台含明文 FLAG，LAN 暴露前自行评估。
# 确需放行才设 SERVER_HOST_IP=0.0.0.0（答案泄露风险自担）。
# SERVER_PORT=8000
# SERVER_HOST_IP=127.0.0.1
