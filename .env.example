# ══════════════════════════════════════════════════════════
# TsecBench 求解 worker — 运行时配置模板
# 复制为 .env 并填入实际值。core 平台自身配置见 README(独立于本文件)。
# ══════════════════════════════════════════════════════════

# ── 平台地址与凭据 (必填; 托管模式由平台注入) ──
BENCHMARK_TOKEN=replace-with-your-platform-token
BENCHMARK_BASE_URL=http://127.0.0.1:8000

# ── LLM 凭据 — pi 官方 provider env 名,直通容器(仓库代码不读不改) ──
# 默认 provider 为 deepseek,官方 env 名 = DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 换 provider: 在 docker-compose.yaml 加一行同名转发,并在此用其官方 env 名
# (provider→env 对照表见 README,或 https://pi.dev/docs/latest/providers)

# ── 模型 (可选; 完整 [provider/]model 逐字透传,缺省 deepseek/deepseek-v4-flash) ──
# SOLVER_MODEL=deepseek/deepseek-v4-flash

# ── 可选: 单会话时长 / VPN 配置 / flag 格式 / 心跳容忍 ──
# SOLVER_SESSION_SECONDS=1500
# ADAPTER_VPN_CONFIG=/vpn/client.ovpn
# ADAPTER_FLAG_FORMAT=flag{...}
# PI_STALL_TIMEOUT=480
# WATCHDOG_MAX_IDLE_SECONDS=300

# ── 可选: 实时监视页/SSE 端口(0=禁用,求解不受影响)与 worker 名 ──
# STATUS_PORT=8080
# WORKER_ID=worker-1
