# ══════════════════════════════════════════════════════════════
# TsecBench 平台接入层适配器 — 运行时配置模板
# 复制为 .env 并填入实际值
# ══════════════════════════════════════════════════════════════

# ── 答题 API (平台发放; 托管模式由平台注入) ──
BENCHMARK_TOKEN=replace-with-your-platform-token
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com

# ── 模型配置 (solver 与 verifier 共用) ──
# 可选 provider: deepseek / deepseek-1m / glm / glm-1m
ADAPTER_PROVIDER=deepseek
SOLVER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 托管网关模式 ──
# 设为 1 时，将 API 域名转为 http://<host>.tsecbench.gw
SOLVER_GATEWAY=0

# ── 调度参数 ──
# 并行挑战数 (对齐平台活跃实例上限)
ADAPTER_MAX_CONCURRENCY=3
# 整体运行挂钟上限 (秒)
ADAPTER_TOTAL_SECONDS=21300
# 工作目录根
ADAPTER_WORKDIR=/work

# ── 止损参数 ──
# 单题最大总时间 (秒)
ADAPTER_PER_CHALLENGE_SECONDS=4000
# 单题最大会话数
ADAPTER_MAX_SESSIONS=8
# 连续无新事实允许的会话数
ADAPTER_DRY_FACTS_CUTOFF=3
# 否定式质疑投票数
SKEPTIC_VOTES=1

# ── 可选: VPN 配置 ──
# ADAPTER_VPN_CONFIG=/path/to/client.ovpn
# ADAPTER_VPN_AUTH=/vpn/auth.txt
# ADAPTER_VPN_KEEPALIVE=1

# ── 可选: 验证器 LLM 覆盖 ──
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-v4-flash

# ── 可选: 过滤 ──
# ADAPTER_ONLY_CODES=code1,code2
# ADAPTER_ONLY_DIFFICULTY=easy,medium
# ADAPTER_MAX_CHALLENGES=10
