# ══════════════════════════════════════════════════════════════
# TsecBench 平台接入层适配器 — 运行时配置模板
# 复制为 .env 并填入实际值
# ══════════════════════════════════════════════════════════════

# ── 答题 API (平台发放; 托管模式由平台注入) ──
BENCHMARK_TOKEN=your-task-issued-token
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com

# ── 模型配置 (solver 与 verifier 共用) ──
# 可选 provider: deepseek / deepseek-1m / glm / glm-1m
ADAPTER_PROVIDER=deepseek
SOLVER_API_KEY=sk-your-deepseek-api-key

# ── 托管网关模式 ──
# 设为 1 时，将 API 域名转为 http://<host>.tsecbench.gw
SOLVER_GATEWAY=0

# ── 调度参数 ──
# 并行挑战数 (对齐平台活跃实例上限)
ADAPTER_MAX_CONCURRENCY=3
# 整体运行挂钟上限 (秒)
ADAPTER_TOTAL_SECONDS=21300
# 各轮单题访问时长 (秒, 递增; 轮数 = 元素个数)
ADAPTER_ROUND_TIMEBOXES=480,820,1500,2000
# 是否使用平台提示 (非简单题、仅卡住时)
ADAPTER_USE_HINTS=0
# 实例保活配额
ADAPTER_KEEPALIVE_MAX=2
# 工作目录根
ADAPTER_WORKDIR=/work

# ── 止损参数 ──
# 单题最大总时间 (秒，与困难题 90 分钟时间盒对齐)
ADAPTER_PER_CHALLENGE_SECONDS=5400
# 单题最大会话数
ADAPTER_MAX_SESSIONS=8
# 连续无新事实允许的会话数
ADAPTER_DRY_FACTS_CUTOFF=3
# 单 flag 题连续 3 场未拿到平台确认 flag 即切换题目
ADAPTER_ZERO_FLAG_CUTOFF=3
# 多 flag/内网多段题单个 Pi 会话的工具调用上限。它只作用于多段题，
# 仍受题目时间盒、StopLoss 与收齐全部 flag 的完成判定约束。
ADAPTER_MULTIFLAG_MAX_TURNS=120
# 多段题连续无进展后先看一次平台提示，再给完整复核窗口；设为 0 仅用于
# 没有 hint 接口的适配器（仍会执行一次流程复核，不会在阈值处直接切题）。
ADAPTER_MULTIFLAG_HINT_REVIEW=1
# 提示后连续无新增事实的会话数，达到后才允许证据化切题。
ADAPTER_MULTIFLAG_POST_HINT_DRY_SESSIONS=3
# 找到并写入 FLAG 后的投递轮询间隔（秒）；投递队列未变化时不会反复解析转录。
ADAPTER_EAGER_SUBMIT_INTERVAL=3
# 否定式质疑投票数
SKEPTIC_VOTES=1

# ── 可选: VPN 配置 ──
# Compose 默认读取 vpn/client.ovpn，一般无需覆盖
# ADAPTER_VPN_CONFIG=/vpn/client.ovpn
# 空闲隧道被判定重连前的秒数；worker-1 entrypoint 实际消费此项。
# ADAPTER_VPN_PING_RESTART=600

# ── 可选: 验证器 LLM 覆盖 ──
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_MODEL=deepseek-v4-flash

# ── 可选: 过滤 ──
# ADAPTER_ONLY_CODES=code1,code2
# ADAPTER_ONLY_DIFFICULTY=easy,medium
# ADAPTER_MAX_CHALLENGES=10
